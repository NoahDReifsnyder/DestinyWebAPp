# Development configuration migrated from the legacy main branch.

DESTINY_ENV=development
DESTINY_HOST=localhost
DESTINY_PORT=42697
DESTINY_SSL_CERT_PATH=util/CERT.pem
DESTINY_SSL_KEY_PATH=util/KEY.pem
DESTINY_DATABASE_PATH=data/destiny.sqlite3
DESTINY_INVENTORY_STALE_SECONDS=300
DESTINY_MANIFEST_PATH=data/manifest.sqlite3
DESTINY_MANIFEST_LANGUAGE=en
DESTINY_SESSION_COOKIE_NAME=destiny_session

# This callback matches the legacy Bungie application registration.
BUNGIE_CLIENT_ID=41804
BUNGIE_CLIENT_SECRET=""
BUNGIE_API_KEY=""
BUNGIE_REDIRECT_URI=https://localhost:42697/redirect
